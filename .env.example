# Copy to .env and fill in. Never commit .env.
# Only needed for the hosted LLM reader (INVOICEGUARD_READER=claude).
ANTHROPIC_API_KEY=
# Leave empty. Only for testing against a stand-in provider or an approved proxy (https required)
ANTHROPIC_BASE_URL=
# Model used for reading invoices (leave empty for the default, claude-sonnet-5-5)
INVOICEGUARD_MODEL=
# Where customer databases and uploaded files live (the Docker image uses /data)
INVOICEGUARD_DATA_DIR=./data
# 24+ random characters. Enables the /admin endpoints. Leave empty to switch them off.
INVOICEGUARD_ADMIN_TOKEN=
# Largest accepted upload in megabytes
INVOICEGUARD_MAX_UPLOAD_MB=10
# Requests per minute allowed per customer
INVOICEGUARD_RATE_LIMIT_PER_MIN=60
# Invoices read by the extraction provider at the same time. Protects provider cost and rate limits.
INVOICEGUARD_MAX_CONCURRENT_READS=4
# Wrong keys allowed per minute from one address before it is locked out for a minute
INVOICEGUARD_AUTH_FAILURES_PER_MIN=20
# Your public address, used in welcome messages and Slack links, e.g. https://invoices.example.com
INVOICEGUARD_PUBLIC_URL=
# Set to 1 ONLY when running behind your own reverse proxy (docker-compose.prod.yml does this for you)
INVOICEGUARD_TRUST_PROXY=
# Production only: addresses allowed to call /admin from outside, space separated. Empty = this server only (use the command line).
ADMIN_ALLOW=
# Production only: your domain, e.g. invoices.example.com (used by Caddy)
DOMAIN=
# claude (default) uses the hosted LLM extraction provider (Anthropic API). local reads text already in a PDF,
# and images when tesseract is installed.
# local does not use ANTHROPIC_API_KEY and is not a measured accuracy figure.
INVOICEGUARD_READER=claude
# Host port for docker-compose.yml, bound to 127.0.0.1. Change it when 8000 is taken.
INVOICEGUARD_HOST_PORT=8000
# Folder `invoiceguard doctor` checks for a fresh backup when --backup-dir is left out.
INVOICEGUARD_BACKUP_DIR=
# Prod compose backup loop: seconds between successful backups, and how many archives to keep on this machine.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP=14
# Seconds to wait and try again when there is no database yet, and after a backup that actually failed.
BACKUP_EMPTY_RETRY_SECONDS=60
BACKUP_FAILURE_RETRY_SECONDS=300
# Optional extra copy of each archive. Offsite only if this path is another machine. Empty means no extra copy.
INVOICEGUARD_OFFSITE_BACKUP_DIR=
# Optional URL of a checker you run. Empty means none is configured, and nothing is alerted.
INVOICEGUARD_MONITOR_URL=
